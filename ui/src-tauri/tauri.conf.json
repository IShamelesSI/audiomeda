{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiomeda",
  "version": "0.1.0",
  "identifier": "com.audiomeda.mixer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audiomeda",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "audiomeda-ui"
}